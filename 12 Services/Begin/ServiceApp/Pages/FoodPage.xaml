<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ServiceApp.ViewModels"
             xmlns:models="clr-namespace:ServiceApp.Models"
             x:Class="ServiceApp.Pages.FoodPage"
             Title="FoodPage" x:DataType="{x:Type viewModels:FoodViewModel}">
    <VerticalStackLayout>
        <ListView ItemsSource="{Binding Foods}" Margin="20" >
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type models:FoodModel}">
                    <TextCell Text="{Binding Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Label Text="{Binding DeviceId}" />
    </VerticalStackLayout>
</ContentPage>